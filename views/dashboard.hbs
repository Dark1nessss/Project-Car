    <main id="customer-support-section" class="hidden">
        <div class="ticket-header">
            <div class="summary">
                <div class="summary-item">
                    <span class="summary-count">10</span>
                    <span class="summary-label">New</span>
                </div>
                <div class="summary-item">
                    <span class="summary-count">20</span>
                    <span class="summary-label">Open</span>
                </div>
                <div class="summary-item">
                    <span class="summary-count">5</span>
                    <span class="summary-label">Unassigned</span>
                </div>
                <div class="summary-item">
                    <span class="summary-count">15</span>
                    <span class="summary-label">Closed</span>
                </div>
            </div>
            <button class="create-ticket">Create Ticket</button>
        </div>

        <div class="ticket-controls">
            <input type="text" id="search-tickets" placeholder="Search in tickets">
            <div class="filters">
                <select id="filter-status">
                    <option value="">Filter by Status</option>
                    <option value="open">Open</option>
                    <option value="pending">Pending</option>
                    <option value="in-progress">In Progress</option>
                    <option value="closed">Closed</option>
                </select>
                <select id="filter-priority">
                    <option value="">Filter by Priority</option>
                    <option value="urgent">Urgent</option>
                    <option value="important">Important</option>
                    <option value="normal">Normal</option>
                </select>
                <select id="filter-assigned">
                    <option value="">Filter by Assigned to</option>
                    <option value="team1">Team 1</option>
                    <option value="team2">Team 2</option>
                </select>
            </div>
        </div>

        <table class="ticket-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Assigned to</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr data-ticket-id="ticket-1">
                    <td>ID12345</td>
                    <td>Products are not working, pls help</td>
                    <td class="priority urgent">Urgent</td>
                    <td>Product</td>
                    <td>Issue</td>
                    <td>Peeves</td>
                    <td><span class="status-label status-in-progress">In Progress</span></td>
                </tr>
                <tr data-ticket-id="ticket-2">
                    <td>ID12346</td>
                    <td>Users cannot login their accounts</td>
                    <td class="priority urgent">Urgent</td>
                    <td>System</td>
                    <td>Issue</td>
                    <td>Not assigned</td>
                    <td><span class="status-label status-in-progress">In Progress</span></td>
                </tr>
                <!-- Add more rows as needed -->
            </tbody>
        </table>
    </main>

    <!-- Ticket Details Modal -->
    <div id="ticket-details-modal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>
            <div class="modal-header">
                <h2 id="modal-ticket-title">Ticket Details</h2>
            </div>
            <div class="modal-body">
                <div class="ticket-info">
                    <h4>Ticket Information</h4>
                    <p><strong>Ticket ID:</strong> <span id="modal-ticket-id"></span></p>
                    <p><strong>User ID:</strong> <span id="modal-user-id"></span></p>
                    <p><strong>Name:</strong> <span id="modal-user-name"></span></p>
                    <p><strong>Incident Title:</strong> <span id="modal-incident-title"></span></p>
                    <p><strong>Description:</strong> <span id="modal-incident-description"></span></p>
                    <p><strong>Status:</strong> <span id="modal-incident-status" class="status-label"></span></p>
                </div>
                <div class="chat-section">
                    <h4>Chat</h4>
                    <div class="chat-messages" id="chat-messages"></div>
                    <div class="chat-input">
                        <input type="text" id="chat-input" placeholder="Type a message">
                        <button id="send-message-btn">Send</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger" id="close-ticket-btn">Close Ticket</button>
                <button class="btn btn-warning" id="refer-ticket-btn">Refer Ticket</button>
            </div>
        </div>
    </div>


