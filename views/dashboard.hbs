                    <span class="links_name">Support</span>
                </a>
                <span class="tooltip">Support</span>
            </li>
            <li>
                <a href="#" class="" id="reviews">
                    <i class='bx bxs-comment-detail'></i>
                    <span class="links_name">Reviews</span>
                </a>
                <span class="tooltip">Reviews</span>
            </li>
            <li>
                <a href="#" class="" id="stock">
                    <i class='bx bx-store'></i>
                    <span class="links_name">Stock</span>
                </a>
                <span class="tooltip">Stock</span>
            </li>
            <li>
                <a href="#" class="" id="accounts">
                    <i class='bx bxs-user-account'></i>
                    <span class="links_name">Accounts</span>
                </a>
                <span class="tooltip">Accounts</span>
            </li>
            <li>
                <a href="#" class="" id="settings">
                    <i class='bx bx-cog'></i>
                    <span class="links_name">Settings</span>
                </a>
                <span class="tooltip">Settings</span>
            </li>
        </ul>
        <div class="profile_content">
            <div class="profile">
                <div class="profile_details">
                    <a href="/profile"><img src="/uploads/{{foto_perfil}}" alt="Profile Picture"></a>
                    <div class="name_job">
