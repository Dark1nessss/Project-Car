    <main id="customer-support-section" class="hidden">
        <div class="ticket-header">
            <div class="summary">
                <div class="summary-item">
                    <span class="summary-count">10</span>
                    <span class="summary-label">New</span>
                </div>
                <div class="summary-item">
                    <span class="summary-count">20</span>
                    <span class="summary-label">Open</span>
                </div>
                <div class="summary-item">
                    <span class="summary-count">5</span>
                    <span class="summary-label">Unassigned</span>
                </div>
                <div class="summary-item">
                    <span class="summary-count">15</span>
                    <span class="summary-label">Closed</span>
                </div>
            </div>
            <button class="create-ticket">Create Ticket</button>
        </div>
        
        <div class="ticket-controls">
            <input type="text" id="search-tickets" placeholder="Search in tickets">
            <div class="filters">
                <select id="filter-status">
                    <option value="">Filter by Status</option>
                    <option value="open">Open</option>
                    <option value="pending">Pending</option>
                    <option value="in-progress">In Progress</option>
                    <option value="closed">Closed</option>
                </select>
                <select id="filter-priority">
                    <option value="">Filter by Priority</option>
                    <option value="urgent">Urgent</option>
                    <option value="important">Important</option>
                    <option value="normal">Normal</option>
                </select>
                <select id="filter-assigned">
                    <option value="">Filter by Assigned to</option>
                    <option value="team1">Team 1</option>
                    <option value="team2">Team 2</option>
                </select>
            </div>
        </div>
        
        <table class="ticket-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Assigned to</th>
                    <th>Status</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                <tr onclick="openTicketDetails('ticket-1')">
                    <td>ID12345</td>
                    <td>Products are not working, pls help</td>
                    <td class="priority urgent">Urgent</td>
                    <td>Product</td>
                    <td>Issue</td>
                    <td>Peeves</td>
                    <td>In Progress</td>
                    <td><button class="view-details" data-ticket-id="ticket-1">View Details</button></td>
                </tr>
                <tr onclick="openTicketDetails('ticket-2')">
                    <td>ID12346</td>
                    <td>Users cannot login their accounts</td>
                    <td class="priority urgent">Urgent</td>
                    <td>System</td>
                    <td>Issue</td>
                    <td>Not assigned</td>
                    <td>In Progress</td>
                    <td><button class="view-details" data-ticket-id="ticket-1">View Details</button></td>
                </tr>
                <!-- Add more rows as needed -->
            </tbody>
        </table>

        <!-- Ticket Details Sidebar -->
        <div id="ticket-details-sidebar" class="ticket-sidebar hidden">
            <div class="sidebar-content">
                <span class="close-btn" onclick="closeTicketDetails()">&times;</span>
                <h2 id="ticket-id">#ID12345</h2>
                <h3 id="ticket-title">Configuration Security Failed</h3>
                <p id="ticket-description">
                    I followed the instructions for setting up AWS Security Hub and received an error similar to one of the following:
                    <ul>
                        <li>AWS Config is not enabled on all necessary regions.</li>
                        <li>AWS Config is not enabled in all regions.</li>
                        <li>An error has occurred with AWS Config. Contact AWS Support.</li>
                    </ul>
                </p>
                <div class="attachments">
                    <h4>Attachments</h4>
                    <ul id="attachment-list">
                        <li><a href="#">document.pdf</a></li>
                        <li><a href="#">screenshot.png</a></li>
                    </ul>
                </div>
                <div class="chat">
                    <h4>Chat</h4>
                    <div class="chat-messages" id="chat-messages">
                        <div class="message">Admin: Please provide more details.</div>
                        <div class="message customer">Customer: I am seeing this error frequently.</div>
                    </div>
                    <div class="chat-input">
                        <input type="text" id="chat-input" placeholder="Type a message">
                        <button onclick="sendMessage()">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

